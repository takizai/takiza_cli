# ==============================================================================
# Takiza Code — Environment Configuration Template
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# AI Provider API Key (Required for cloud providers: OpenAI, Groq, OpenRouter, DeepSeek)
# For Ollama / local LLMs, you can leave this empty.
OPENAI_API_KEY=your_api_key_here

# OpenAI compatible API Endpoint
# Default presets:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   DeepSeek:    https://api.deepseek.com
#   Ollama:      http://localhost:11434/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Model Name
# Examples:
#   Groq:        llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
#   OpenAI:      gpt-4o, gpt-4o-mini, o3-mini
#   OpenRouter:  anthropic/claude-3.5-sonnet, openai/gpt-4o
#   DeepSeek:    deepseek-chat, deepseek-reasoner
#   Ollama:      qwen2.5-coder:latest, deepseek-r1:latest
OPENAI_MODEL=llama-3.3-70b-versatile

# Optional: HTTP/HTTPS or SOCKS5 Proxy
# TAKIZA_PROXY=http://127.0.0.1:10809
# TAKIZA_PROXY=socks5://127.0.0.1:10808

# Maximum model steps per prompt (default: 100; 0 disables the limit)
TAKIZA_MAX_STEPS=100

# Optional: Tavily web search (takes priority over Brave/Bing RSS)
# Get your key at https://app.tavily.com/
# TAVILY_API_KEY=tvly-your-key
